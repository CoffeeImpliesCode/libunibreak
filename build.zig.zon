.{
    .name = .libunibreak,
    // Upstream C library release.
    .version = "8.0.0",
    .fingerprint = 0xb4b2629221124f29, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    .paths = .{
        // Build scripts and the cross-test profile.
        "build.zig",
        "build.zig.zon",
        "cross-test.profile.sh",
        // Zig facade and tests.
        "zig",
        // Runtime loader sources.
        "runtime",
        // Public test and smoke roots.
        "tests.zig",
        "smoke.zig",
        // Upstream sources, fixtures, generated tables and tooling.
        "src",
        // Upstream design documentation.
        "doc",
        // Upstream build metadata and licence texts.
        ".clang-format",
        ".mailmap",
        "LICENCE",
        "LICENCE-UNICODE.txt",
        "README.md",
        // Upstream's original README.
        "README.upstream.md",
        "NEWS",
        "AUTHORS",
        "Makefile.am",
        "configure.ac",
        "autogen.sh",
        "bootstrap",
        "purge",
        "libunibreak.pc.in",
        "Doxyfile",
        // Fork provenance records.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "README.zig.md",
        "FORK-NOTES.md",
        "CHANGELOG.md",
        // Fork licence grant.
        "FORK-LICENSE.md",
        // Separate package that consumes this module by path.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream tools and the sample installed by this build.
        "tools",
        // Nix and devenv entry points and the pinned flake lock.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
