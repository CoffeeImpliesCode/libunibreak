# direnv entry for the canonical devenv shell.
#
# `devenv direnvrc` prints the integration from the devenv that is already
# installed, so this file pins no URL and no hash of its own: there is nothing
# here that could drift away from the tool that would read it.
#
# `use devenv` accepts the same options as `devenv shell`; `--quiet` silences it.
export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv